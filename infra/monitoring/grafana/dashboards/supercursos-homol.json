{
  "uid": "supercursos-homol",
  "title": "SuperCursos - Observabilidade HOMOL",
  "description": "Saúde e tráfego do Core, contingência da IA, eventos IoT e processamento eventual. Métricas coletadas pelo Prometheus.",
  "tags": [
    "supercursos",
    "homol",
    "devops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Status da API",
      "description": "UP indica que o Prometheus consegue coletar as métricas da API.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-supercursos"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"supercursos-api\"}",
          "legendFormat": "API",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "Sem coleta",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Requisições HTTP / segundo",
      "description": "Tráfego da aplicação; exclui sondas /actuator. Aguarda tráfego inicial.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-supercursos"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"supercursos-api\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "HTTP/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "Aguardando tráfego",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Tempo médio de resposta HTTP",
      "description": "Média das requisições da aplicação nos últimos 60 segundos, sem sondas /actuator.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-supercursos"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"supercursos-api\",uri!~\"/actuator.*\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"supercursos-api\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "Latência média"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "Aguardando tráfego",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Memória JVM - Heap",
      "description": "Soma dos segmentos de memória heap da JVM.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-supercursos"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"supercursos-api\",area=\"heap\"})",
          "legendFormat": "Heap utilizado"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "Aguardando tráfego",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Contingências do serviço de IA",
      "description": "Aumenta quando o Core responde com fallback porque o serviço Python não está disponível.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus-supercursos"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "sum by (operacao) (supercursos_ai_fallback_total)", "legendFormat": "{{operacao}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 6,
      "title": "Eventos IoT recebidos",
      "description": "Eventos MQTT aceitos e persistidos pelo Core, por tipo.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus-supercursos"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [{"refId": "A", "expr": "sum by (tipo) (supercursos_iot_eventos_recebidos_total)", "legendFormat": "{{tipo}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 7,
      "title": "Falhas no processamento da Outbox",
      "description": "Falhas de consumidor deixam eventos pendentes para nova tentativa.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus-supercursos"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [{"refId": "A", "expr": "sum(supercursos_outbox_falhas_total)", "legendFormat": "falhas"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}

