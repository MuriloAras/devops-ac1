          },
          "tooltip": {
            "mode": "single"
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_sum{job=\"supercursos-api\",uri!~\"/actuator.*\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"supercursos-api\",uri!~\"/actuator.*\"}[1m])), 1e-9)",
            "legendFormat": "Latência média",
            "refId": "A"
