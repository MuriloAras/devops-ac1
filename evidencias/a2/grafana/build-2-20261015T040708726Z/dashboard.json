            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single"
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{job=\"supercursos-api\",uri!~\"/actuator.*\"}[1m]))",
            "legendFormat": "HTTP/s",
            "refId": "A"
          }
        ],
        "title": "Requisições HTTP / segundo",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-supercursos"
        },
        "description": "Média das requisições da aplicação nos últimos 60 segundos, sem sondas /actuator.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "min": 0,
            "noValue": "Aguardando tráfego",
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
